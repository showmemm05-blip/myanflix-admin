# Copy to .env before running docker compose: cp .env.example .env
# (Separate from .env.local, which `next dev`/`next start` use directly —
# this one only feeds docker-compose.yml's build arg.)

NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
PORT=3002

# Build time only (passed as a docker build arg): extra origins the browser may
# open connections to, space-separated. Set it to the origin of the backend's
# MINIO_PUBLIC_ENDPOINT (backend/.env) — the browser PUTs book PDFs, replacement
# videos and (with NEXT_PUBLIC_USE_DIRECT_MINIO_UPLOAD=true) bulk uploads
# straight there. When set, the Content-Security-Policy connect-src is locked
# to the admin, the API and these origins (audit M-31). When unset or empty,
# connect-src stays open to any http/https origin so uploads keep working, but
# a script injected into the admin could send a stolen staff token anywhere,
# and `next build` prints a SECURITY warning. Change it together with
# MINIO_PUBLIC_ENDPOINT, then rebuild the admin image.
CSP_CONNECT_SRC_EXTRA=http://localhost:8443
